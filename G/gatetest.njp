
class gatetest public

  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg .

    say '~'.copies(60).overlay(' gate1 ', 3)
    do label _gatet1

      pipe (gatet1   end ? debug 0 )
          gen 1000 |
          locate /00/ |
          specs /gated/ 1 1-* nextw |
          console |
          locate /900/ |
       a: gate ?

          gen 1000 |
          a: |
          locate /00/ |
          console ?

          gen 1000 |
          a: |
          locate /00/ |
          console ?

          gen 1000 |
          a: |
          locate /00/ |
          console ?
          -- end of pipe

    end _gatet1
    say

    say '~'.copies(60).overlay(' gate2 ', 3)
    do label _gatet2

      pipe (gatet2   end ? debug 0 )
          gen 500 |
          locate /00/ |
          specs /gated/ 1 1-* nextw |
          console |
          locate /300/ |
       a: gate strict |
          gen 1000 |
          a: |
          locate /00/ |
          console ?

          gen 1000 |
          a: |
          locate /00/ |
          console ?

          gen 1000 |
          a: |
          locate /00/ |
          console ?
          -- end of pipe

    end _gatet2
    say

    exit

