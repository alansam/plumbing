-- NOW  ?
   datecvx now |
   c9: compare any ~2# 9 NOW \nActual:\n\\p\nExpected:\n Today's Date Year-Month-Day~|
   o: ?
   literal ** |
   c9: ?

-- NOW USA ?
   datecvx now usa |
   c10: compare any ~2#10 NOW USA\nActual:\n\\p\nExpected:\n Today's Date Month/Day/Year~|
   o: ?
   literal ** |
   c10: ?
