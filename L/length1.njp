pipe (lengthp) < length1.njp | length1 | console

import org.netrexx.njpipes.pipes.

class length1 extends stage final
  
  method run()
    do
      loop forever
        line = rexx peekto()
        l = line.length
        output(l.right(2, 0) l.d2x.right(2, 0) line)
        readto()
      end
    catch StageError
      rc = rc()
    end

    exit(rc * (rc <> 12))

  
