/* NetRexx Pipes */
-- © Copyright The Rexx Language Association, 2011-2026
/*
 * As with the original var_test01 this fails to compile because there's a problem with
 * the compiler not correctly adding all the Rexx variables to the setContext() API.
 *
 * Compiling with -gen I was able to edit the NRX to add both variables to setContext.
 * Compiled with the NetRexxC compiler the generated source files create valid class files.
 *
 * Substituting the 'var' stage with 'gen' avoids the problen with setContext as 
 * there is now only one input stage accessing a Rexx variable ['varover'].
 *
 * 2026-06-25 - Alan Sampson
 */

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class varovertest510X public

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method varovertest510X public
    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static
    arg = Rexx(args)
    Bb = Rexx 15
    vo = Rexx 10

    parse arg gn .
    gn = Rexx gn
    if \gn.datatype('w') then
      gn = 3

    Bb[0] = 5
    Bb[1] = 'Bb value 1'
    Bb[2] = 'Bb value 2'
    Bb[3] = 'Bb value 3'
    Bb[5] = '~'.copies(10)

    say '.'.copies(60)
    say 'Bb:' Bb
    say 'vo:' vo
    say
    say 'vo[1]:' vo[1]
    say

    loop _b = 0 to Bb[0]
      say 'Bb['_b.right(2, 0)']:' Bb[_b].right(12)
    end _b
    say

    pipe (varoverpipe5 end ?)
      gen {gn} |
      a: varover Bb |
      b: faninany |
      stem vo ?
      a: |
      b:

    say
    say '.'.copies(60)
    say 'Bb:' Bb
    say 'vo:' vo
    say

    loop _b = 0 to Bb[0]
      say 'Bb['_b.right(2, 0)']:' Bb[_b].right(12)
    end _b
    say

    if vo[0] > 0 then
      loop _v = 0 to vo[0]
        say 'vo['_v.right(2, 0)']:' vo[_v].strip.right(12)
      end _v
    say

    exit

/** var -- Read a NetRexx Variable Value

 >>--+--VAR--------+--variable_name---><
      +--VAR_STAGE--+

 Note:
 NetRexx Pipelines is read variable only; must be first stage in the pipe.
 Must be the first stage in the pipe.  This can not set a NetRexx value.
 /
 VAR_STAGE is the internal class name, VAR is the generally used alias./
 This is avoid conflict with a Java name./
 */

/** varover -- Extract all the indexes of a rexx variable.

  >>--VAROVER--var_name---><

  Note: NetRexx Pipelines only; not CMS
        If the secondary output stream is connected, the root is passed on it.
 */

/** faninany -- Copy Records from Whichever Input Stream Has One

 >>--FANINANY-+------------+-----><
              +-STRICT-(1)-+

  (1) CMS only

 */

