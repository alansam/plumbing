import org.netrexx.njpipes.pipes.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class doc_stages extends stage public final

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method doc_stages public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    pipe (dm stall 1000 debug 0 )
      < pipe-stages.a | locate | not locate /#/ |
      specs word 1 1 | sort | join 4 / / | menufmt | cons

    exit

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

