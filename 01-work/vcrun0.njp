#!/usr/bin/env nr
/* NetRexx Pipes */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

import org.netrexx.njpipes.pipes.
import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class vcrun0 public

  properties private constant
    K_key = 'MELANCHOLY_DANE'

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg job dataset sjnr key .

    do label _jobbies
      if job.length = 0 | job = '.' then job = 'e'
      job = job.lower()

      if sjnr.length = 0 | sjnr = '.' then sjnr = 50

      if key.length = 0 | key = '.' then key = K_key

      if dataset.length() = 0 | dataset = '.' then
        signal IllegalArgumentException("dataset name is a required argument")

      outset = dataset'.out'

      select case job
        when 'e' then do label _vcr0e

          pipe (vcr0e stall 1000 debug 0 )
            diskr {dataset} |
            specs 1-* 1 / / next |
            join {sjnr} |
            vcencipher {key} |
            vcfmt |
            diskw {outset}

          say 'output:' outset

          pipe (vcr0er stall 1000 debug 0 )
            diskr {outset} |
            console

        end _vcr0e
        when 'd' then do label _vcr0d

          pipe (vcr0d stall 1000 debug 0 )
            diskr {dataset} |
            specs 1-* 1 / / next |
            join {sjnr} |
            vcdecipher {key} |
            vcfmt |
            diskw {outset}

          say 'output:' outset

          pipe (vcr0dr stall 1000 debug 0 )
            diskr {outset} |
            console

        end _vcr0d
        otherwise do
          say 'job '''job''' unknown; nothing to do'
        end
      end

    catch ex = IllegalArgumentException

      say givehelp()
      say ex.toString()

    catch tx = Throwable

      say tx.toString()

    end _jobbies

    exit

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method givehelp() public static

    parse source env meth file .
    parse file cmd '.' .

    meth = meth -- prevents compiler warning

    helpmsg = -
      '/** Encipher or decipher the contents of a file.\n\n' -
      '    $' env.lower() cmd 'job dataset sjnr key\n' -
      '        job     : e -- encode [default ''e'']\n' -
      '                : d -- decode\n' -
      '        dataset : input dataset name\n' -
      '        snjr    : record join count  [default ''50'']\n' -
      '        key     : cipher key  [default, use built-in key]\n' -
      '*/'

    return helpmsg

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

