
  pipe (filea0 stall 1000 debug 0 )
   o: faninany |
      spec 1-* 4 |
      console ?

      literal data appended to end of file |
      split |
      diska ./tmp/filew0_out.a3 ?

      diskr ./tmp/filew0_out.a3 |
      take last 15 |
      o: ?

  -- disk/file handling stages:
  --   < diskr filer, > diskw filew, >> diska filea, diskslow

