#!/usr/bin/env nr
/* NetRexx Pipes */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

import org.netrexx.njpipes.pipes.
import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class SequenceNumbers public

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg infile .
    if infile.length = 0 then do
      say 'job needs a file name.'
      exit 1
    end

    RC = 0
    do
      say ('.'.copies(80)).overlay(' 'infile' ', 4)

      pipe (sn stall 1000 debug 0 )
       < {infile} |
       specs 1.72 1.72 pad 0 number 73.4 right _0000_ 77 |
       console

      RC = 0
    catch ex = Exception
      say 'GRONK!:' ex.getMessage
      RC = 1
    end

    exit RC

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
