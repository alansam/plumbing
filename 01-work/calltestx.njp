import org.netrexx.njpipes.pipes.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class calltestx extends stage public final

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method run() public
    do
      a = arg()

      callpipe (cp1x debug 0 ) gen {a} | *out:

      loop forever
        line = peekto()
        output(line)
        readto()
      end
    catch StageError
      rc = rc()
    end

    exit(rc * (rc <> 12))

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg gc .
    if gc.datatype('w') \= 1  then
      gc = 5

    pipe (callt1x debug 0 )
      literal test |
      calltestx {gc} |
      specs words 1 1-10 right |
      console

    exit

