
  pipe (viggy0a stall 1000 debug 0 )
   o: faninany |
      spec 1-* 4 |
      console ?

      < ./data/shag/tomorrow_macbeth.a1 |
      join 50 |
  d1: vigenere debug encode |
  v1: fanout |
  d2: vigenere debug decode |
  v2: fanout ?

      d1: |
      spec /D1:/ 1 1-* nw |
      o: ?

      d2: |
      spec /D2:/ 1 1-* nw |
      o: ?

      v1: |
      fanin 0 1 |
      vcfmt |
      spec /V1:/ 4 1-* nw |
      console ?

      v2: |
      fanin 0 1 |
      vcfmt |
      spec /V2:/ 4 1-* nw |
      console ?
      -- fin

