
  pipe (space0 stall 1000 debug 0 )
   o: faninany |
      buffer |
      sort 1 singleok |
      spec 1-* 4 |
      console ?

      literal  a     b   b |
      space|
      insert ,*, after |
      spec /1: / 1 1-* NR @return "\U25BA"data@ next |
      o: ?

      literal  a     b   b |
      space blank |
      insert ,*, after |
      spec /2: / 1 1-* NR @return "\U25BA"data@ next |
      o: ?

      literal 3.6=7,3 |
      space 0 anyof /,.=/ |
      spec /3: / 1 1-* NR @return "\U25BA"data@ next |
      o: ?

      literal a b   c     d |
      space /(*)/ |
      spec /4: / 1 1-* NR @return "\U25BA"data@ next |
      o: ?

      literal a b   c     d |
      space 2 /(*)/ |
      spec /5: / 1 1-* NR @return "\U25BA"data@ next |
      o: ?
      -- fin

