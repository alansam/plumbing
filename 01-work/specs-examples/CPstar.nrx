/* NetRexx Pipes */
options replace format comments java nobinary
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

  dlm = '....o....O....o....O....o....O....o....O....o....O....o....O'

  say dlm
  say "pipe \-"
  say -
      "< CPstar.nrx |" -
      "spec 1-* 1 /*/ next | " -
      "cons"

  Address pipe -
      "< CPstar.nrx | spec 1-* 1 /*/ next | cons"
  say RC

  exit RC

