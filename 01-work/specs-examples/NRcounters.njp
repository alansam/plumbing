/* NetRexx Pipes */
options replace format comments java nobinary
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

  dlm = '....o....O....o....O....o....O....o....O....o....O....o....O' 

  say dlm
  say "pipe \-"
  say -
      "literal abc |" -
      "spec 1-* NR /counter[7]=counter[7]+1;ret=data.reverse counter[7];return ret/ 1 |" -
      "cons"

  Address pipe -
      "literal abc | spec 1-* NR /counter[7]=counter[7]+1;ret=data.reverse counter[7];return ret/ 1 | cons"
  say RC

  exit RC

