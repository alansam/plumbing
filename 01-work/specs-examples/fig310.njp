
pipe (f310 )
  literal 1~one 2~two 3~three 4~four | split | xlate /~/ / |
  specs
        printonly eof
        a: word 1 .
        set (#0+=a; #1+=1)
        eof
        print #1 strip 1
        /obs;/ nextword
        print #0 strip nextword
        /tot;/ nextword
        print #0/#1+.005 picture zzzzzzz9.99 strip nextword
        /avg./ nextword |
  console ?

