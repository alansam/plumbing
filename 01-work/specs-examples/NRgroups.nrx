/* NetRexx Pipes */
options replace format comments java nobinary
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

  dlm = '....o....O....o....O....o....O....o....O....o....O....o....O' 

  say dlm
  say "pipe \-"
  say -
      "literal abc | spec T:1-* 10-16, 1.2 NR @rev = field['T'].reverse; return rev@ 1 | cons"

  Address pipe -
      "literal abc | spec T:1-* 10-16, 1.2 NR @rev = field['T'].reverse; return rev@ 1 | cons"
  say RC

  exit RC

