#!/usr/bin/env nr
/* NetRexx Pipes */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

import org.netrexx.njpipes.pipes.
import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class dictw0 extends stage public final

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)

    _dlm   = '='.copies(60)

  properties private unused
    memvar_ = Rexx '' -- maybe ...

  properties private static
    dwarves_ = Hashtable()
    stim_ = ''

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method dictw0() public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
--method run() public

--  rc = 0

--  exit(rc * (rc <> 12))

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method prep() private static

    stim_[0] = 0
    _0 = stim_[0]
    _0 = _0 + 1; stim_[_0] = 'A'
    _0 = _0 + 1; stim_[_0] = 'Thorin Oakenshield'
    _0 = _0 + 1; stim_[_0] = 'B'
    _0 = _0 + 1; stim_[_0] = 'Fíli'
    _0 = _0 + 1; stim_[_0] = 'C'
    _0 = _0 + 1; stim_[_0] = 'Kíli'
    _0 = _0 + 1; stim_[_0] = 'D'
    _0 = _0 + 1; stim_[_0] = 'Balin'
    _0 = _0 + 1; stim_[_0] = 'E'
    _0 = _0 + 1; stim_[_0] = 'Dwalin'
    _0 = _0 + 1; stim_[_0] = 'F'
    _0 = _0 + 1; stim_[_0] = 'Óin'
    _0 = _0 + 1; stim_[_0] = 'G'
    _0 = _0 + 1; stim_[_0] = 'Glóin'
    _0 = _0 + 1; stim_[_0] = 'H'
    _0 = _0 + 1; stim_[_0] = 'Dori'
    _0 = _0 + 1; stim_[_0] = 'I'
    _0 = _0 + 1; stim_[_0] = 'Nori'
    _0 = _0 + 1; stim_[_0] = 'J'
    _0 = _0 + 1; stim_[_0] = 'Ori'
    _0 = _0 + 1; stim_[_0] = 'K'
    _0 = _0 + 1; stim_[_0] = 'Bifur'
    _0 = _0 + 1; stim_[_0] = 'L'
    _0 = _0 + 1; stim_[_0] = 'Bofur'
    _0 = _0 + 1; stim_[_0] = 'M'
    _0 = _0 + 1; stim_[_0] = 'Bombur'
    stim_[0] = _0

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg .

    prep()

    say '   ' || _dlm
    do label _plumbing

      pipe (dictw0 stall 1000 debug 0 )
       o: faninany |
          specs 1-* 4 |
          console ?

          stemr stim_ |
          dictw {dwarves_} ?

          literal Copy collection from Rexx stem to Hashtable |
          spec 1-* 1.60 centre |
          o:

 -- catch ex = Exception /* perhaps */
 --   ...
 --   say ex.toString()
    end _plumbing
    say

    say '   \-'
    say 'Thorin and Company:' (Rexx dwarves_.size()).right(6) 'members.'
    if \dwarves_.isEmpty() then do
      loop _v over dwarves_
        say '   ' || (Rexx _v).right(3) || ':' dwarves_.get(_v)
      end _v
    end
    say
    
    exit

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

