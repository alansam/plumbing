#!/usr/bin/env nr
/* NetRexx Pipes */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

import org.netrexx.njpipes.pipes.
import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class stemming public

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)

  properties private unused
    memvar_ = Rexx '' -- maybe ...

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method stemming() public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg .

    do label stemming

      T = ''
      F = ''; F[0] = 3; F[1] = 'zzz'; F[2] = 'qqq'; F[3] = 'aaa';
      avar = 'plugh'

      loop _f over F
        say _f F[_f]
      end _f
      say

      pipe (stemming stall 1000 debug 0 )
           stem F |
           sort |
           prefix literal {avar} |
           console |
           stem T

      say
      loop _f over F
        say _f F[_f]
      end _f

      say
      loop _t over T
        say _t T[_t]
      end _t
      say

    end stemming

    exit

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

