
  pipe (xrange0 stall 1000 debug 0 )
   o: faninany |
      buffer |
      sort 1-* singleok |
      console ?

      xrange 30.10 |
      spec /1:/ 1 1-* nw |
      o: ?

      xrange ! 0 |
      spec /2:/ 1 1-* nw |
      o: ?

      xrange a i |
      spec /3:/ 1 1-* nw |
      o: ?

      xrange 30 39 |
      spec /4:/ 1 1-* nw |
      o: ?

      xrange 68.5 |
      spec /5:/ 1 1-* nw |
      o: ?

      xrange 68-74 |
      spec /6:/ 1 1-* nw |
      o: ?

      xrange 42 47 |
      spec /7:/ 1 1-* nw |
      o: ?
      -- fin

