#!/usr/bin/env nr
/* NetRexx Pipes */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

import org.netrexx.njpipes.pipes.
import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class hashr0 extends stage public final

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)

    _dlm   = '='.copies(60)

  properties private unused
    memvar_ = Rexx '' -- maybe ...
    stim_ = ''

  properties private static
    dwarves_ = Hashtable()

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method hashr0() public

    return

-- . ...1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
--method run() public

--  rc = 0

--  exit(rc * (rc <> 12))

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method prep() private static

    dwarves_.put(Rexx 'A', Rexx 'Thorin Oakenshield')
    dwarves_.put(Rexx 'B', Rexx 'Fíli')
    dwarves_.put(Rexx 'C', Rexx 'Kíli')
    dwarves_.put(Rexx 'D', Rexx 'Balin')
    dwarves_.put(Rexx 'E', Rexx 'Dwalin')
    dwarves_.put(Rexx 'F', Rexx 'Óin')
    dwarves_.put(Rexx 'G', Rexx 'Glóin')
    dwarves_.put(Rexx 'H', Rexx 'Dori')
    dwarves_.put(Rexx 'I', Rexx 'Nori')
    dwarves_.put(Rexx 'J', Rexx 'Ori')
    dwarves_.put(Rexx 'K', Rexx 'Bifur')
    dwarves_.put(Rexx 'L', Rexx 'Bofur')
    dwarves_.put(Rexx 'M', Rexx 'Bombur')

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg .

    prep()

    say '    ' || _dlm
    do label _plumbing

      pipe (hashr0 stall 1000 debug 0 )
       o: faninany |
          specs 1-* 4 |
          console ?

--        stemr  stim_ |
          hashr {dwarves_} |
          join / / |
          buffer |
       k: count lines |
          sort qsort 1-1 |
          spec 2-* 1.60 centre |
          o: ?

          k: |
          spec /Thorin and Company:/ 1 1-* nw.5 right /members./ nw |
          spec 1-* 1.60 centre |
          o: ?
          -- end of pipe

 -- catch ex = Exception /* perhaps */
 --   ...
 --   say ex.toString()
    end _plumbing
    say

    exit

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

