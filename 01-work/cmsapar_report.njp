  pipe (cmsapar_report end ? stall 1000 debug 0 )
      diskr ./tmp/applied-apars.a3 |
      specs 1-7 4 |
      sort |
      unique |
   a: fanin |
      console ?

      literal ~~~~~~~ |
      specs 1-7 4 |
      a: ?

      diskr ./tmp/missing-apars.a3 |
      sort |
      unique |
      specs 1-7 4 |
      a: ?

