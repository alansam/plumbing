#!/usr/bin/env nr
/* NetRexx Pipes */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

import org.netrexx.njpipes.pipes.
import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class pitmatic1 extends stage public final

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)

  properties private unused
    memvar_ = Rexx '' -- maybe ...

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method pitmatic1() public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
--method run() public

--  rc = 0

--  exit(rc * (rc <> 12))

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg .

    do label _plumbing

      say 'Data processing.'
      do label _proc
        pipe (proc stall 1000 debug 0 )
         o: faninany |
            spec 1-* 4 |
            console ?

            < ./data/pit_village.a1 |
            spec fieldseparator , field 1 1 field 2 30 field 3 50 |
            change /"// |
         f: fanout |
            buffer |
            sort 1-28 a singleok |
            > ./tmp/pitmatic_name.a3 ?

            f: |
            buffer |
            sort 29-36 d singleok |
            > ./tmp/pitmatic_N2S.a3 ?

            f: |
            buffer |
            sort 49-55 a singleok | -- NOTE: offsets must take into account UTF-8 degree symbol |
            > ./tmp/pitmatic_E2W.a3 ?
            -- fin
      end _proc
      say

      say 'Results files.'
      do label _px
        pipe (px stall 1000 debug 0 )
            literal ./tmp/pitmatic_name.a3;,
                    ./tmp/pitmatic_N2S.a3;,
                    ./tmp/pitmatic_E2W.a3 |
            split ; |
            strip both |
            spec 1-* 4 |
            console ?
            -- fin
      end _px
      say

      say 'Report: by name.'
      do label _name
        pipe (name stall 1000 debug 0 )
            < ./tmp/pitmatic_name.a3 |
            spec recno 4.4 right 1-* nw | -- recno is a synonym of number |
            console ?
            -- fin
      end _name
      say

      say 'Report: by North to South.'
      do label _ns
        pipe (ns stall 1000 debug 0 )
            < ./tmp/pitmatic_N2S.a3 |
            spec number 4.4 right 1-* nw |
            console ?
            -- fin
      end _ns
      say

      say 'Report: by East to West'
      do label _ew
        pipe (ew stall 1000 debug 0 )
            < ./tmp/pitmatic_E2W.a3 |
            spec number 4.4 right 1-* nw |
            console ?
            -- fin
      end _ew
      say

 -- catch ex = Exception /* perhaps */
 --   ...
 --   say ex.toString()
    end _plumbing

    exit

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

