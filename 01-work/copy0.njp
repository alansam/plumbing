
-- To hold the output on the primary output stream from chop while the balance
-- of the input record is being written to the secondary output stream, and the
-- two pieces are to be reunited in a later stage:

-- Records that have a leading blank are passed in their entirety to the
-- secondary output stream after a null record has been written to the primary
-- output stream.

  pipe (copy0 stall 1000 debug 0 )
   o: faninany |
      spec 1-* 4 |
      console ?

      < ./data/muse_henryv.a1 |
   c: chop before blank |
      xlate upper |
      copy |
   s: spec 1-* 1 select 1 1-* next |
      > ./data/muse-HI_henryv.a1 |
      o: ?

      c: |
      s:

