#!/usr/bin/env nr
/* NetRexx Pipes */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

import org.netrexx.njpipes.pipes.
import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class keyboard_yn public final

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)

  properties private unused
    memvar_ = Rexx '' -- maybe ...

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method keyboard_yn() public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
--method run() public

--  rc = 0

--  exit(rc * (rc <> 12))

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg .

    cbuff    = ''
    cbuff[0] = 0

    do label _plumbing

      -- terminal is a synonym for 'console'
      pipe (b0 end ? stall 1000 debug 0 )
       o: faninany |
          spec 1-* 4 |
          console ?

          terminal eof ~.*~ prompt ~Enter Y or N (to terminate input use .*):~ |
       d: locate anycase 1 anyof /YN/ |
          xlate |
          spec /yes YN/ 1 1-* nw |
       q: fanout |
          o: ?

          q: |
          gate strict ?

          d: |
       f: fanout |
          spec /no YN/ 1 1-* nw |
          o: ?

          f: |
          buffer |
          stemw cbuff ?
          -- fin

    end _plumbing

    say '--' 0.right(3)':' cbuff[0]
    loop _r = 1 to cbuff[0]
      say '--' _r.right(3)':' cbuff[_r]
    end _r
    say

    exit

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

