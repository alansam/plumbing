#!/usr/bin/env nr
/* NetRexx Pipes */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

import org.netrexx.njpipes.pipes.
import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class generate public

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)

  properties private unused
    memvar_ = Rexx '' -- maybe ...

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method generate() public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg startx endx .

    do label _run
      if startx = '' | endx = '' then -
        signal IllegalArgumentException('start and end arguments are required')

      startd = startx.x2d
      endd   = endx.x2d
      if startd = 0 then -
        signal IllegalArgumentException('start point cannot be zero')

      say 'start:' startx.upper.right(6) startd.right(6)
      say '  end:' endx.upper.right(6)   endd.right(6)
      say

      chopv = startd - 1
      maxv = endd

      do label _pipe

        pipe (generate stall 1000 debug 0 )
            gen {maxv} |
            drop first {chopv} |
            specs 1-* d2x 4.10 right |
            console

      end _pipe

    catch ex = Exception
      say 'Error:' ex.getMessage()'.'

    end _run

    exit

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

