#!/usr/bin/env nr
/* NetRexx Pipes */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

import org.netrexx.njpipes.pipes.
import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class SequenceNumbersVarLen extends stage public final

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)

  properties private unused
    memvar_ = Rexx '' -- maybe ...

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method SequenceNumbersVarLen() public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
--method run() public

--  rc = 0

--  exit(rc * (rc <> 12))

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg infile .
    if infile.length = 0 then do
      say 'job needs a file name.'
      exit 1
    end

    RC = 0

    do label _plumbing
      say ('.'.copies(80)).overlay(' 'infile' ', 4)

      pipe (vl stall 1000 debug 0 )
         < {infile} |
          spec pad 0 recno 1.4 right,
               /0000/ 5,
               1-* 9 | -- recno is a synonym of number |
          console ?
          -- fin

      RC = 0
    catch ex = Exception
      say 'GRONK!:' ex.getMessage
      RC = 1
    end _plumbing

    exit RC

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

