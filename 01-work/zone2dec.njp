#!/usr/bin/env nr
/* NetRexx Pipes */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

import org.netrexx.njpipes.pipes.
import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class zone2dec extends stage public final

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)

  properties private unused
    memvar_ = Rexx '' -- maybe ...

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method zone2dec() public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method run() public

    rc = 0

    -- addpipe, callpipe etc.
    do label _runny
      target = arg()

      parse target . -- prevent warning message

      /*
       --                          /* njpipes doesn't work with col 2 */ |
       -- spec 5 1 1-* 2
       -- spec 5 3 1-* 4 |        -- /* Sign to 3 1-5 to 4-8          */ |
       -- spec 3-* 1 |            -- /* reset to col 1                */ |
       -- xlate 1 00-ff blank        /* Handle sign; default unsigned */ |
       --       C0-I +               /* These get plus ...            */ |
       --       D0-R -               /* and these are negative        */ |
       -- xlate 6                    /* Now do the loworder digit     */ |
       --       C0-I 0-9             /* Remove positive sign          */ |
       --       D0-R 0-9             /* and remove negative sign      */ |
       */

      -- njpipes does some illogical translations. 
      -- use chars that work and change for final fixups

      callpipe (z2d debug 0 )
          *in: |
          spec 5 3 1-* 4 |
          spec 3-* 1 |
          xlate 1 7B + |
          xlate 1 7D . |
          xlate 1 A-I + |
          xlate 1 J-R . |
          xlate 6 7B 30 |
          xlate 6 7D 30 |
          xlate 6 A-I 1-9 |
          xlate 6 J-R 1-9 |
          xlate 1 0-9 _ |
          change 1 /_/ / |
          change 1 /./-/ |
          *out:

    catch StageError
      rc = rc()
    end _runny

    exit(rc * (rc <> 12))

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg .

    do label _plumbing

      -- "  pipe 'literal 12345 1234E 1234N 0000{ 1000} | split | zone2dec | console'"
      pipe (xz)
          literal 12345 1234E 1234N 0000[ 1000] |
          xlate *-* 5B 7B |
          xlate *-* 5D 7D |
          split |
          zone2dec |
          spec 1-* 4 |
          console

    end _plumbing

    exit

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

