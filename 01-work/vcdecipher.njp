/* NetRexx Pipes */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

import org.netrexx.njpipes.pipes.
import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class vcdecipher extends stage public final

  properties constant
    kkey = 'LEMON'

  properties private
    key = kkey

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method run() public
    gkey = arg()
    if gkey.length() > 0 then key = vcipher.stringscrubber(gkey)
    say '>>>>'key
    loop forever
      ciphertext = Rexx peekto()
      deciphertext = vcipher.vigenere_decipher(key, ciphertext)
      output(deciphertext)
      readto()
    catch StageError
      rc = rc()
    end

    exit(rc * (rc <> 12))

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

