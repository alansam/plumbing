#!/usr/bin/env nr
/* NetRexx Pipes */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

import org.netrexx.njpipes.pipes.
import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class vigenere_test0 extends stage public final

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)
    _dlm   = '~'.copies(80)

  properties private unused
    memvar_ = Rexx '' -- maybe ...

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method vigenere_test0() public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
--method run() public

--  rc = 0

--  exit(rc * (rc <> 12))

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg .

    do label _plumbing

      say _dlm

      pipe (vt0 stall 1000 debug 0 )
       o: faninany |
          sort 1.8 |
          spec 1-* 4 |
          console ?

          diskr ./data/jeremy_lyrics.a1 |
       t: fanout |
          join 50 |
       d: vigenere dump key lemon_yellow_sun en |
       r: fanout |
          vcfmt |
          spec /Y/ 1 recno 3.6 right /:/ n 1-* nw | -- of encode |
          o: ?

          r: |
       e: vigenere decode key lemonyellowsun dump |
          vcfmt |
          spec /Z/ 1 recno 3.6 right /:/ n 1-* nw | -- of decode |
          o: ?

          t: |
          spec /A/ 1 recno 3.6 right /:/ n 1-* nw | -- original text |
          o: ?

          d: |
          spec /D encode:/ 1 1-* nw | -- dump |
          o: ?

          e: |
          spec /E decode:/ 1 1-* nw | -- dump |
          o: ?
          -- fin

      say

      say _dlm

      pipe (vt1 stall 1000 debug 0 )
       o: faninany |
          sort 1.8 |
          spec 1-* 4 |
          console ?

          literal aaaaa aaaaa aaaaa aaaaa aaaaa aaaaa aaaaa aaaaa aaaaa aaaaa aaaaa aaaaa | -- force key exposure |
          literal lemon yello wsunl emony ellow sunle monye llows unlem onyel lowsu nlemo |
          sort a |
       t: fanout |
          join 3 |
          vigenere key lemon_yellow_sun enc |
       r: fanout |
          vcfmt |
          spec /Q/ 1 recno 3.6 right /:/ n 1-* nw | -- of encode |
          o: ?

          r: |
          vigenere deco key lemon$yellow$sun |
          vcfmt |
          spec /R/ 1 recno 3.6 right /:/ n 1-* nw | -- of decode |
          o: ?

          t: |
          spec /B/ 1 recno 3.6 right /:/ n 1-* nw | -- original text |
          o: ?
          -- fin

      say

      say _dlm

      pipe (vt2 stall 1000 debug 0 )
       o: faninany |
          sort 1.8 |
          spec 1-* 4 |
          console ?

          literal lemon yello wsunl emony ellow sunle monye llows unlem onyel lowsu nlemo |
          literal aaaaa aaaaa aaaaa aaaaa aaaaa aaaaa aaaaa aaaaa aaaaa aaaaa aaaaa aaaaa | -- force key exposure |
          sort d |
       t: fanout |
          join 3 |
          vigenere key lemonyellowsun encod |
       r: fanout |
          vcfmt |
          spec /V/ 1 recno 3.6 right /:/ n 1-* nw | -- of encode |
          o: ?

          r: |
          vigenere decod key lemon*yellow*sun |
          vcfmt |
          spec /W/ 1 recno 3.6 right /:/ n 1-* nw | -- of decode |
          o: ?

          t: |
          spec /C/ 1 recno 3.6 right /:/ n 1-* nw | -- original text |
          o: ?
          -- fin

      say

 -- catch ex = Exception /* perhaps */
 --   ...
 --   say ex.toString()
    end _plumbing

    exit

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

