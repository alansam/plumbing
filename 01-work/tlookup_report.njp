pipe (tlookup_report end ? stall 1000 debug 0 )
  < detail_records.a1 |
  specs 1-* 4 |
  sort |
  unique |
  a: fanin |
  console ?
  literal ....o....1....o....2....o....3....o....4....o....5....o....6 |
  specs 1-* 4 |
  a: ?
  < master_records.a1 |
  sort |
  unique |
  specs 1-* 4 |
  a: ?
  literal ....o....1....o....2....o....3....o....4....o....5....o....6 |
  specs 1-* 4 |
  a: ?
  < matching_records.a3 |
  sort |
  unique |
  specs 1-* 4 |
  a: ?
  literal ....o....1....o....2....o....3....o....4....o....5....o....6 |
  specs 1-* 4 |
  a: ?
  < unmatched_details.a3 |
  sort |
  unique |
  specs 1-* 4 |
  a: ?
  literal ....o....1....o....2....o....3....o....4....o....5....o....6 |
  specs 1-* 4 |
  a: ?
  < unreferenced_masters.a3 |
  sort |
  unique |
  specs 1-* 4 |
  a: ?
  literal ....o....1....o....2....o....3....o....4....o....5....o....6 |
  specs 1-* 4 |
  a:

