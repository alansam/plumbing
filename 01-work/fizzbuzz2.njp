#!/usr/bin/env nr
/* NetRexx Pipes */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

import org.netrexx.njpipes.pipes.
import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class fizzbuzz2 extends stage public final

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)

  properties private unused
    memvar_ = Rexx '' -- maybe ...

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method fizzbuzz2() public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
--method run() public

--  rc = 0

--  exit(rc * (rc <> 12))

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg va vb grn .

    va = va.strip()
    vb = vb.strip()
    grn = grn.strip()

    select
      when grn = '.'             then grn = 100
      when grn.length() = 0      then grn = 100
      when grn.datatype('W') = 0 then grn = 100
      otherwise nop
    end

    select
      when va = '.'             then va = 3
      when va.length() = 0      then va = 3
      when va.datatype('W') = 0 then va = 3
      otherwise nop
    end

    select
      when vb = '.'             then vb = 5
      when vb.length() = 0      then vb = 5
      when vb.datatype('W') = 0 then vb = 5
      otherwise nop
    end

    do label _plumbing

      pipe (fb stall 1000 debug 0 )
       o: faninany |
          spec 1-* 4 |
          console ?

          gen {grn} |               -- generate 1..N numbers |
          insert ,+{va}+{vb}+, before | -- looking for factors of 3 & 5 |
          spec 1-* NETREXX @,
            /* NetRexx program to fizz, buzz, & fizzbuzz */,
            parse data '+' va '+' vb '+' gnr .;,
            if va = '.' then va = 3;,
            if vb = '.' then vb = 5;,
            if (gnr.datatype('W') = 0) then return data;,
            select;,
              when ((gnr // va == 0) & (gnr // vb == 0)) then data = 'FizzBuzz';,
              when ( gnr // va == 0) then data = 'Fizz';,
              when ( gnr // vb == 0) then data = 'Buzz';,
              otherwise data = gnr;,
            end;,
            return data;,
          @ 1.12 right |
          spec recno 1.6 right /:/ next 1-* nextword |
          o: ?
          -- fin

 -- catch ex = Exception /* perhaps */
 --   ...
 --   say ex.toString()
    end _plumbing

    exit

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

