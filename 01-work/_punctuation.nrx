#!/usr/bin/env nr
/* NetRexx */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal nostrictsignal

-- remove comments for NetRexx Pipes class imports
-- import org.netrexx.njpipes.pipes.
-- import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class _punctuation public

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)

    gullymet = [ '\U00AB\U00A0', '\U00A0\U00BB' ] -- guillemetes + NBRS
    _L = 0
    _R = 1

  properties private unused
    memvar_ = Rexx '' -- maybe ...

  properties private
    yomp = ''

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method _punctuation() public

    setup()

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method simple_runner() private

    ctr = 1
    loop _y = 1 to yomp[0]
      do label _yomps
        yod = yomp[_y].c2d().right(5, 0)
        yox = yomp[_y].c2x().right(4, 0)

        say gullymet[_L] || yomp[_y] || gullymet[_R] || -
            ', d'''yod'''' || -
            ', x'''yox'''' || -
            ''
        if ctr // 16 = 0 then say
        ctr = ctr + 1
      end _yomps
    end _y

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method runner() private

--  do label _unsup

    ctr = 1
    ctr = ctr
    loop _y = 1 to yomp[0]
      do label _yomps
        lz = yomp[_y].toString()
        zc = lz.charAt(0)
        cp = lz.codePointAt(0)

        pn = ''
        do label _getname
          cn = Character.getName(cp)
          pn = Rexx(cn)
        catch exnpe = NullPointerException
          exnpe = exnpe -- swallow the exception
          pn = '*Unavailable*'
        catch exia = IllegalArgumentException
          exia = exia -- swallow the exception
          pn = '*Unavailable*'
        end _getname

        u8 = [byte 2x00, 2x00]
        do label _getbytes
          u8 = lz.getBytes('UTF-8')
        catch exue = UnsupportedEncodingException
          exue = exue -- swallow exception
          u8 = [byte 2x00, 2x00]
        catch exia = IllegalArgumentException
          exia = exia -- swallow the exception
          u8 = [byte 2x00, 2x00]
        end _getbytes

        yod = yomp[_y].c2d().right(5, 0)
        yox = yomp[_y].c2x().right(4, 0)
        yo8 = utf_8(u8)

        say gullymet[_L] || yomp[_y] || gullymet[_R] || -
            ', d'''yod'''' || -
            ', x'''yox'''' || -
            '. Unicode: U+'yox || -
            ', UTF-8:' yo8 || -
            ', ''' || pn || ''''

        if ctr // 16 = 0 then say
        ctr = ctr + 1
      catch ex = IllegalArgumentException
        say gullymet[_L] || zc || gullymet[_R]'\-'
        say '<<>>'cp'\-'
        say '<<->>'Rexx(cp).d2x()'\-'
        say '<<->>'ex.toString()
      end _yomps
    end _y

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method utf_8(u8 = byte[]) private static binary
  
    u8r = Rexx ''
    loop _b = 0 to u8.length - 1
      dig = Rexx(Byte.toUnsignedInt(u8[_b]))
      u8r = u8r || "x'"dig.d2x().right(2, 0)"',"
    end _b

    return u8r.strip('t', ',')

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg opt .
    opt = opt.lower()

    instance = _punctuation()

    if 'simple'.abbrev(opt, 1) then do
      instance.simple_runner()
    end
    else do
      instance.runner()
    end

    return

