
  pipe (insert0 stall 1000 debug 0 )
   o: faninany |
      sort singleok |
      spec 1-* 4 |
      console ?

      literal Java |
      insert / NetRexx / |
      spec /0~~~~/ 1 w1-* nw /(default - before)/ nw |
      o: ?

      literal Java |
      insert / NetRexx / after |
      spec /~1~~~/ 1 w1-* nw /(after)/ nw |
      o: ?

      literal Java |
      insert / NetRexx / before |
      spec /~~2~~/ 1 w1-* nw /(before)/ nw |
      o: ?

      literal Java Juice |
      insert / NetRexx / after 3.2 |
      spec /~~~3~/ 1 w1-* nw /(after 3.2)/ nw |
      o: ?

      literal Java Juice |
      insert / NetRexx / before 3.2 |
      spec /~~~~4/ 1 w1-* nw /(before 3.2)/ nw |
      o: ?
      -- end of pipe

