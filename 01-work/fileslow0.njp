
  pipe (fileslow0 stall 1000 debug 0 )
   o: faninany |
      spec 1-* 4 |
      console ?

      fileslow ./data/_ruler |
      buffer |
   f: fanout |
      spec /[   >/ 1 1-* next /<   ]/ next |
      o: ?

      f: |
      spec /[copy>/ 1 1-* next /<copy]/ next |
   k: fanout |
      fileslow ./tmp/fileslow0_out.a3 ?

      k: |
      change 1-* /copy/dup/ |
      o: ?

  -- disk/file handling stages:
  --   < diskr filer, > diskw filew, >> diska filea, diskslow fileslow

