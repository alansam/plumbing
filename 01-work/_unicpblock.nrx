#!/usr/bin/env nr
/* NetRexx */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

-- remove comments for NetRexx Pipes class imports
-- import org.netrexx.njpipes.pipes.
-- import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class _unicpblock public

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)

  properties private unused
    memvar_ = Rexx '' -- maybe ...

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method _unicpblock() public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args).upper()
    if arg.length() <= 0 then
      exit 8

    parse arg 'U+'cpbeg . 'U+'cpend .
    if cpbeg.length() <= 0 & cpend.length() <= 0 then
      exit 8

    if cpbeg.datatype('X') & cpend.datatype('X') then
      nop
    else
      exit 8

    if cpbeg.length() > 4 | cpend.length() > 4 then
      exit 8

    cpbeg_d = cpbeg.x2d()
    cpend_d = cpend.x2d()

    if cpbeg_d > cpend_d then
      exit 8

    loop _cd = cpbeg_d to cpend_d
      ucode = 'U+' || _cd.d2x().right(4, 0)

      _unicodepoint.codepoint(ucode)
    end _cd

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

