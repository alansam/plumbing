#!/usr/bin/env nr
/* NetRexx */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

-- remove comments for NetRexx Pipes class imports
-- import org.netrexx.njpipes.pipes.
-- import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class _unicpblock public

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)

  properties private unused
    memvar_ = Rexx '' -- maybe ...

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method _unicpblock() public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    parse source . . prog'.nrx' .

    do label _rangie
      arg = Rexx(args).upper()
      if arg.length() <= 0 then do
        signal IllegalArgumentException("Usage:" prog "U+nnnn U+nnnn")
      end

      parse arg 'U+'cpbeg . 'U+'cpend .
      if cpbeg.length() <= 0 & cpend.length() <= 0 then do
        signal IllegalArgumentException("Arguments should be prefixed with 'U+'")
      end

      if cpbeg.datatype('X') & cpend.datatype('X') then do
        nop
      end
      else do
        signal IllegalArgumentException("Arguments should be hexadecimal literals")
      end

      if cpbeg.length() > 4 | cpend.length() > 4 then do
        signal IllegalArgumentException("Arguments must be between 1 and 4 digits")
      end

      cpbeg_d = cpbeg.x2d()
      cpend_d = cpend.x2d()

      if cpbeg_d > cpend_d then do
        signal IllegalArgumentException("Arguments must be in ascending order")
      end

      loop _cd = cpbeg_d to cpend_d
        ucode = 'U+' || _cd.d2x().right(4, 0)

        _unicodepoint.codepoint(ucode)
      end _cd

    catch ex = IllegalArgumentException
      say ex.toString()
      exit 8
    end _rangie

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

