#!/usr/bin/env nr
/* NetRexx Pipes */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

import org.netrexx.njpipes.pipes.
import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class hostbyaddr0 extends stage public final

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)

  properties private unused
    memvar_ = Rexx '' -- maybe ...

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method hostbyaddr0() public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
--method run() public

--  rc = 0

--  exit(rc * (rc <> 12))

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg ip .

    if ip.length() = 0 then
      ip = '127.0.0.1' -- localhost

    do label _plumbing

      pipe (h1 stall 1000 debug 0 )
       o: faninany |
          specs 1-* 4 |
          console ?

          literal {ip} |
       a: fanout |
          hostbyaddr |
          spec /host:     / 1 1-* nw |
          o: ?

          a: |
          hostbyaddr includeip |
          spec /host + IP:/ 1 1-* nw |
          o: ?

 -- catch ex = Exception /* perhaps */
 --   ...
 --   say ex.toString()
    end _plumbing

    exit

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

