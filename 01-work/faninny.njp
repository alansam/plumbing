
  pipe (faninny stall 1000 debug 0 )
   o: faninany |
      spec 1-* 4 |
      console ?

      < ./tmp/_commando |
      parse /_1 ':' ./ /_1/ |
      sort |
      unique singleok |
   f: fanout |
      spec 1-* 4 |
      o: ?

      f: |
      count lines |
      spec /File count:/ 1 1-* nw |
      o: ?
      -- end pipe

