
  pipe (date_nano stall 1000 debug 0 )
   o: faninany |
      spec 1-* 4 |
      console ?

      command date -Ins |
   n: fanout |
      spec /-   nano:/ 1 1-* nw |
      o: ?

      n: |
      spec 1-10 1 12-19 12 /./ 20 21-26 21 |
   d: fanout |
      spec /-    iso:/ 1 1-* nw |
      o: ?

      d: |
      dateconv iso eur timeout |
      spec /-    eur:/ 1 1-* nw |
      o: ?
      -- job done

