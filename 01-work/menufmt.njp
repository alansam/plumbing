import org.netrexx.njpipes.pipes.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class menufmt extends stage public final

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method menufmt public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method run() public

    loop forever
      line = Rexx peekTo()
      newline = Rexx ''
      loop wd = 1 to line.words
        newline = newline || line.word(wd).left(14)
      end wd
      newline = newline.strip('t')
      output(newline)
      readTo()
    catch StageError
      rc = rc()
    end

    exit(rc * (rc <> 12))

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

