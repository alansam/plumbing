
  pipe (count0 stall 1000 debug 0 )
   o: faninany |
      spec 1-* 4 |
      console ?

      < ./data/toby_hamlet.a1 |
   k: count words |
      -- remove punctuation |
      xlate *-* 7B-7E _ |
      xlate *-* 21-2F _ |
      xlate *-* 3A-3F _ |
      xlate *-* 5B-60 _ |
      xlate *-* 5F 20 |
      -- record cleanup |
      strip both blank |
      space 1 |
      -- prep for sort |
      xlate upper |
      split |
      sort |
      unique 
      drop first 1 | -- discard empty line |
      -- count unique words [one word per line] |
      count lines |
      -- report unique words [observe comma is used as separator] |
      spec 1-* 1.10 right ,unique words., nextword |
      o: ?

      k: |
      -- report total words [observe comma is used as separator] |
      spec 1-* 1.10 right ,words total., nextword |
      o: ?

