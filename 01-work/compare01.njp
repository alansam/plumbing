-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method plumb_nowt(tsa = Rexx, tsb = Rexx) private static

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg .

    say _dlm
    plumb_c01('1,2,3,4', '1,2,3,4')
    plumb_c01('1,5,3,4', '1,2,3,4')
    plumb_c01('1,2,3,4', '1,5,3,4')
    say

    say _dlm
    plumb_c02('1,2,3,4', '1,2,3,4')
    plumb_c02('1,5,3,4', '1,2,3,4')
    plumb_c02('1,2,3,4', '1,5,3,4')
    say

    say _dlm
    plumb_c03('1,2,3,4', '1,2,3,4')
    plumb_c03('1,5,3,4', '1,2,3,4')
    plumb_c03('1,2,3,4', '1,5,3,4')
    say

    say _dlm
    plumb_c04('1,2,3,4', '1,2,3,4')
    plumb_c04('1,2,3',   '1,2,3,4')
    plumb_c04('1,2,3,4', '1,2,3')
    say

    say _dlm
    plumb_c05('1,2,3,4', '1,2,3,4')
    plumb_c05('1,2,3',   '1,2,3,4')
    plumb_c05('1,2,3,4', '1,2,3')
    say

    say _dlm
    plumb_c06('1,2,3,4', '1,2,3,4')
    plumb_c06('1,2,3',   '1,2,3,4')
    plumb_c06('1,2,3,4', '1,2,3')
    say

    say _dlm
    plumb_c07('1,2,3,4', '1,2,3,4')
    plumb_c07('1,2,3',   '1,2,3,4')
    plumb_c07('1,2,3,4', '1,2,3')
    say

    say _dlm
    plumb_c08('1,2,3,4', '1,2,3,4')
    plumb_c08('1,2,3,4', '1,5,3,4')
    plumb_c08('1,5,3,4', '1,2,3,4')
    say

    say _dlm
    plumb_c09('1,2,3,4', '1,2,3,4')
    plumb_c09('1,2,3,4', '1,5,3,4')
    plumb_c09('1,5,3,4', '1,2,3,4')
    say

    say _dlm
    plumb_c10('1,2,3,4', '1,2,3,4')
    plumb_c10('1,2,3',   '1,2,3,4')
    plumb_c10('1,2,3,4', '1,2,3')
    say

    say _dlm
    plumb_c11('1,2,3,4', '1,2,3,4')
    plumb_c11('1,2,3',   '1,2,3,4')
    plumb_c11('1,2,3,4', '1,2,3')
    say

    plumb_nowt('1,2,3,4', '1,5,3,4')

    exit

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

