-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method plumb_c09(tsa = Rexx, tsb = Rexx) private static

    say '-- compare equal /Same/ less /Less/ more /More/ (Same) '
    say '  Test strings:' gullymet[0] || tsa || gullymet[1]',' gullymet[0] || tsb || gullymet[1]
    say

    do label _plumbing

      pipe (c09 stall 1000 debug 0 )
       o: faninany |
          spec 1-* 4 |
          console ?

          literal {tsa} |
          split ; |
      c9: compare equal /Same/ less /Less/ more /More/ |
     c9a: compare any      ~2# 9 compare equal /Same/ less /Less/ more /More/ (Same)  \n\n~,
                  equal    ~OK!~,
                  notequal ~GRONK! at rec \\c col \\b.\n~,
                  less     ~  Less:\n      Actual: \\p\n    Expected: \\s\n~,
                  more     ~  More:\n      Actual: \\p\n    Expected: \\s\n~ |
          o: ?

          literal {tsb} |
          split ; |
          c9: ?

          literal Same |
          c9a: ?
          -- end of pipe

      say

    end _plumbing

