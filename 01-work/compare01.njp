c08#!/usr/bin/env nr
/* NetRexx Pipes */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

import org.netrexx.njpipes.pipes.
import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class compare01 extends stage public final

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)

    _dlm = '~'.copies(60)

    gullymet = [ '\U00AB\U00A0', '\U00A0\U00BB' ] -- guillemetes + NBRS

  properties private unused
    memvar_ = Rexx '' -- maybe ...

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method compare01() public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
--method run() public

--  rc = 0

--  exit(rc * (rc <> 12))

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method plumb_c01(tsa = Rexx, tsb = Rexx) private static

    say '-- compare (equal)'
    say '  Test strings:' gullymet[0] || tsa || gullymet[1]',' gullymet[0] || tsb || gullymet[1]
    say

    do label _plumbing

      pipe (c01 stall 1000 debug 0 )
       o: faninany |
          spec 1-* 4 |
          console ?

          literal {tsa} |
          split ; |
      c1: compare |
     c1a: compare any      ~2# 1 compare (equal) \n\n~,
                  equal    ~OK!~,
                  notequal ~GRONK! at rec \\c col \\b.\n~,
                  less     ~  Less:\n      Actual: \\p\n    Expected: \\s\n~,
                  more     ~  More:\n      Actual: \\p\n    Expected: \\s\n~ |
          o: ?

          literal {tsb} |
          split ; |
          c1: ?

          literal 0 |
          c1a: ?
          -- end of pipe
      say

 -- catch ex = Exception /* perhaps */
 --   ...
 --   say ex.toString()
    end _plumbing

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method plumb_c02(tsa = Rexx, tsb = Rexx) private static

    say '-- compare (greater)'
    say '  Test strings:' gullymet[0] || tsa || gullymet[1]',' gullymet[0] || tsb || gullymet[1]
    say

    do label _plumbing

      pipe (c02 stall 1000 debug 0 )
       o: faninany |
          spec 1-* 4 |
          console ?

          literal {tsa} |
          split ; |
      c2: compare |
     c2a: compare any      ~2# 2 compare (greater) \n\n~,
                  equal    ~OK!~,
                  notequal ~GRONK! at rec \\c col \\b.\n~,
                  less     ~  Less:\n      Actual: \\p\n    Expected: \\s\n~,
                  more     ~  More:\n      Actual: \\p\n    Expected: \\s\n~ |
          o: ?

          literal {tsb} |
          split ; |
          c2: ?

          literal 1 |
          c2a: ?
          -- end of pipe
      say

    end _plumbing

    return

