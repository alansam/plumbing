
  pipe (multigetf stall 1000 debug 0 )
   o: faninany |
      spec 1-* 4 |
      console ?

      strliteral ,ls ./data/, |
      command |
      casei locate /.a0/ |
      spec ,./data/, 1 1-* n |
   f: fanout |
      spec /File:/ 1 1-* nw |
      o: ?

      f: |
      getfiles |
      specs
          recno from 10000 by 1000 1
          /!/ 11
          1-* 12
          /!/ 92 |
      specs
          /000/ 1
          6-*   4 |
      o: ?
      -- end of pipe

