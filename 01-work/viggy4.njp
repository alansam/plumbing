#!/usr/bin/env pipe -f

  pipe (viggy4 stall 1000 debug 0 )
   o: faninany |
      sort |
      spec 1-* 4 |
      console ?

      literal abc;def;ghi |
      split ; |
  d1: vigenere dump |
   f: fanout |
      spec /C/ 1 recno n.1 right /:/ n 1-* nw |
      o: ?

      f: |
  d2: vigenere decode dump |
      spec /D/ 1 recno n.1 right /:/ n 1-* nw |
      o: ?

      d1: |
      spec /c/ 1 recno n.1 right /:/ n 1-* nw |
      o: ?

      d2: |
      spec /d/ 1 recno n.1 right /:/ n 1-* nw |
      o: ?
      -- fin

