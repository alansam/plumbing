#!/usr/bin/env nr
/* NetRexx */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

-- remove comments for NetRexx Pipes class imports
-- import org.netrexx.njpipes.pipes.
-- import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class date_posix public

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)

    _posix = 'Fri Oct 16 07:47:56 PDT 2026'

--  parse 'DNAME MNAME DAY TIME TZONE YEAR HOUR MINUTE SECOND' -
--         DNAME MNAME DAY TIME TZONE YEAR HOUR MINUTE SECOND
    DNAME  = 'DNAME'
    MNAME  = 'MNAME'
    DAY    = 'DAY'
    TIME   = 'TIME'
    TZONE  = 'TZONE'
    YEAR   = 'YEAR'
    HOUR   = 'HOUR'
    MINUTE = 'MINUTE'
    SECOND = 'SECOND'

  properties private unused
    memvar_ = Rexx '' -- maybe ...

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method date_posix() public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg .

    _date = ''
    _date[0] = 0
    _date = date_parts()

    say -
      '   '_posix
    say -
      '   '_date[DNAME] _date[MNAME] _date[DAY] _date[TIME] _date[TZONE] _date[YEAR]
    say -
      '   '_date[HOUR] || ':' || _date[MINUTE] || ':' || _date[SECOND]
    say 

    loop _dd over _date
      say _dd.right(10) || ':' _date[_dd]
    end _dd
    say

    _pip = 'pipe (dp stall 1000 debug 0 )\n' -
           '    literal' _posix '|\n' -
           '    spec 1-* 4 |\n' -
           '    console |\n' -
           '    dateconv posix iso timeout |\n' -
           '    spec 1-* 4 |\n' -
           '    console ?\n' -
           '    -- all done'

    say '  ' _pip
    say

    address pipe _pip
    say

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method date_parts() private static returns Rexx

    _date = ''
    _date[0] = 0

    parse _posix $DNAME $MNAME $DAY $TIME $TZONE $YEAR -
        0 . . . $HOUR ':' $MINUTE ':' $SECOND .

    _date[DNAME]  = $DNAME
    _date[MNAME]  = $MNAME
    _date[DAY]    = $DAY
    _date[TIME]   = $TIME
    _date[TZONE]  = $TZONE
    _date[YEAR]   = $YEAR
    _date[HOUR]   = $HOUR
    _date[MINUTE] = $MINUTE
    _date[SECOND] = $SECOND

  return _date

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

