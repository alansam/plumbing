
  pipe (putside0 stall 1000 debug 0 )
   o: faninany |
      buffer |
      sort 2-9 singleok |
      spec 1-* 4 |
      console ?

      < ./data/colossal_data.a1 |
   f: fanout |
      outside /0/ /1/ |
      spec ,<A outside /0/ /1/ >, 1 1-* nw |
      o: ?

      f: |
      inside /0/ /1/ |
      spec ,<A inside  /0/ /1/ >, 1 1-* nw |
      o: ?

      f: |
      outside /0/ /1/ |
      spec ,<B outside /0/ 2   >, 1 1-* nw |
      o: ?

      f: |
      inside /0/ /1/ |
      spec ,<B inside  /0/ 2   >, 1 1-* nw |
      o: ?

      f: |
      spec ,<                  >, 1 1-* nw |
      o: ?
      -- fin

