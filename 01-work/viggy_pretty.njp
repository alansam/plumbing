
  pipe (viggy_pretty stall 1000 debug 0)
      < {} |                  -- argument is input file, read it |
      xlate |                 -- uppercase |
      translate !-@ = [-~ = | -- letters between 1 - @ & [ - ~ to = |
      space 0 blank = |       -- remove = |
      space 0 |               -- remove speces |
      join 50 |               -- combine up to 50 records |
      vcfmt |                 -- cipher formatter |
      console ?
      -- fin

