
  pipe (zone0 stall 1000 debug 0 )
   o: faninany |
      buffer |
      sort 1-* singleok |
      console ?

      literal 012;345; noises on;678;9AB;CDE;~noises off;FGH;IJK |
      split ; |
      zone -3;-1 reverse between /no/ /ffo/ |
      spec /1:/ 1 1-* nw |
      o: ?

      literal 012;345; noises on;678;9AB;CDE;~noises off;FGH;IJK |
      split ; |
      zone w2 between /on/ /off/ |
      spec /2:/ 1 1-* nw |
      o: ?

      literal line 1.1;line 1.2 last;;line 2.1;line 2;Line 2.2;LIne 2.3 LAST;;LINE 3.1 last |
      split ; |
  dA: fanout ?

      dA: |
      zone w2 find 1 |
      spec /3:/ 1 1-* nw |
      o: ?

      dA: |
      zone w2 reverse find 1|
      spec /4:/ 1 1-* nw |
      o: ?

      dA: |
  z5: zone w2 reverse find 1|
      hole ?

      z5: |
      spec /5:/ 1 1-* nw |
      o: ?

      dA: |
      zone w3 reverse casei find T |
      spec /6:/ 1 1-* nw |
      o: ?

      dA: |
  z7: zone w3 reverse casei find T |
      hole?

      z7: |
      spec /7:/ 1 1-* nw |
      o: ?

      literal 123 343 456 222 323 |
      split |
  dB: fanout |
      hole ?

      dB: |
      zone (2.1 2.1) find 22 |
      spec /8:/ 1 1-* nw |
      o: ?

      dB: |
      zone (2.1 -1;-1) find 23 |
      spec /9:/ 1 1-* nw |
      o: ?

      dB: |
      zone 2.1 find 2 |
      spec /A:/ 1 1-* nw |
      o: ?
      -- fin

