#!/usr/bin/env nr
/* NetRexx Pipes */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

import org.netrexx.njpipes.pipes.
import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class viggy3 extends stage public final

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)
    _dlm   = '~'.copies(80)

  properties private unused
    memvar_ = Rexx '' -- maybe ...

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method viggy3() public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
--method run() public

--  rc = 0

--  exit(rc * (rc <> 12))

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg .

    pathpfx = './data/shag/'
    files = ''
    files[0] = 0

    do label _plumbing

      pipe (sel stall 1000 debug 0 )
       o: faninany |
          specs 1-* 4 |
          console ?

          literal ls {pathpfx} |
          command |
          nlocate /.a3/ |
          sort |
          spec recno 1.4 right /:/ n 1-* nw |
       s: fanout |
          o: ?

          s: |
          spec w2 1 |
          insert ,{pathpfx}, before |
          space 0 |
          stemw files ?
          -- fin

      fnr = 0
      say
      say _dlm
--    loop _f = 1 to files[0]
--      say _f.right(4)':' files[_f]
--    end _f
      say 'Choose a file: \-'
      parse pull fnr .
      fnr = fnr.strip()

--scr = showtype(fnr)
--parse scr .
/*
say '>>>'"'"fnr"'" ''''showtype(fnr).strip('T')''''
say '>>>     W' (fnr.datatype('W'))
say '>>> not W' (\fnr.datatype('W'))
say '>>>'(fnr >= 1 | fnr <= files[0])
say '>>>'((fnr.datatype('W')) & (fnr >= 1 & fnr <= files[0]))
*/

      if ((fnr.datatype('W')) & (fnr >= 1 & fnr <= files[0])) then do
        chosen = files[fnr]
        say 'You chose:' chosen
      end
      else do
--say '<<< Oh, my!'
        signal IllegalArgumentException('GRONK!: Invalid input '''fnr'''')
      end

      parse source . . name '.' .
      textcopy   = './tmp/' || name || '.txt'
      ciphertext = './tmp/' || name || '.ciphertext'
      plaintext  = './tmp/' || name || '.plaintext'
      say 'Text copied to' textcopy
      say 'Cipher text to' ciphertext
      say 'Deciphered results to' plaintext
      say

      lct = ''
      lct[0] = 0

      pipe (kt1 stall 1000 debug 0 )
          diskr {chosen} |
       k: count lines |
       p: fanout |
          diskw {textcopy} ?

          p: |
          spec />/ 4 recno nw.4 right /:/ n 1-* nw |
          console ?

          k: |
          stemw lct ?
          -- fin

      if lct[0] = 0 then do
        signal RuntimeException("GRONK! Unable to calculate file size.")
      end

      maxjoin = lct[1] + 1

      pipe (vce stall 1000 debug 0 )
       o: faninany |
          spec 1-* 4 |
          console ?

          diskr {chosen} |
          join {maxjoin} |
          vigenere encode |
          vcfmt |
       s: fanout |
          diskw {ciphertext} ?

          s: |
          literal Encoded: |
          o: ?
          -- fin

      lct = ''
      lct[0] = 0

      pipe (kt2 stall 1000 debug 0 )
          diskr {ciphertext} |
          count lines |
          stemw lct ?
          -- fin

      if lct[0] = 0 then do
        signal RuntimeException("GRONK! Unable to calculate file size.")
      end

      maxjoin = lct[1] + 1

      pipe (vcd stall 1000 debug 0 )
       o: faninany |
          spec 1-* 4 |
          console ?

          diskr {ciphertext} |
          join {maxjoin} |
          vigenere decode |
          vcfmt |
       t: fanout |
          diskw {plaintext} ?

          t: |
          literal Decoded: |
          o: ?
          -- fin

      say
      say _dlm
      say 'Data from' chosen
      say 'Text copied to' textcopy
      say 'Cipher text to' ciphertext
      say 'Deciphered results to' plaintext
      say

    catch ex = Exception /* perhaps */
      say ex.toString()
    end _plumbing

    exit

/*
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method showtype(dt = Rexx) private static returns Rexx

    types = ''
    dt = dt.strip()
    if dt.datatype('A') == 1 then
      types = types || 'Alphabetic '
    if dt.datatype('B') == 1 then
      types = types || 'Binary '
    if dt.datatype('D') == 1 then
      types = types || 'Digits '
    if dt.datatype('L') == 1 then
      types = types || 'Lowercase '
    if dt.datatype('M') == 1 then
      types = types || 'Mixedcase '
    if dt.datatype('N') == 1 then
      types = types || 'Number '
    if dt.datatype('S') == 1 then
      types = types || 'Symbol '
    if dt.datatype('U') == 1 then
      types = types || 'Uppercase '
    if dt.datatype('W') == 1 then
      types = types || 'Whole_number '
    if dt.datatype('X') == 1 then
      types = types || 'heXadecimal '

    return types
*/

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

