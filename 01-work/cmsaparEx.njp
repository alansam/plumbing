import org.netrexx.njpipes.pipes.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class cmsaparEx extends stage public final

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method cmsaparEx public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    pipe (cmsapar stall 1000 debug 170 )
      command ./cp_query.rex |
      drop 1 |
      l: lookup 1.7 |
      sort unique 1-7 |
      > applied-apars.a1 ?
      < required-apars.a1 |
      split |
      l: |
      hole ?
      l: |
      > missing-apars.a1
    
    exit

/*
p-i-p-e (cmsapar stall 1000 debug 170 ) 
  | command ./cp_query.rex| drop 1
  | l: lookup 1.7
  | sort unique 1-7
  | > applied-apars.a
  ? < required-apars.a
  | split
  | l:
  | hole
  ? l:
  | > missing-apars.a
*/

