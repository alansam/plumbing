options format java comments replace symbols decimal

import org.netrexx.njpipes.pipes.
import org.netrexx.njpipes.stages.

/*
 *  examples from cms pipelines User's Guide and Reference
 */

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class collate0 public

  properties constant
    _dline = '-'.copies(80)
    _true  = boolean (1 == 1)
    _false = boolean (\_true)

  properties static
    bad_thing = boolean _false

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    do label _runny
      runner()

      if bad_thing then
        signal Exception("something bad happened")

    catch ex = Exception
      say 'GRONK:' ex.toString()
    end _runny

    exit

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method runner() private static

   -- pipe (end ? name c0 )
   --     ?
    say _dline.overlay(' c0 ', 3)
    do label _c0

      pipe (c0 end ? stall 1000 debug 0 )
          literal 1 3 5 |
          split |
          pad left 10 |
       c: collate stop anyof 1.10 master |
       i: faninany |
          spec 1-* 4 |
          console ?

          literal |
          dup * |
          spec number 1 |
          c: ?

          c: |
          insert / Missing./ after |
          i:

    catch ex = Exception
      say 'GRONK:' ex.toString()
      exit 12
    end _c0

    say _dline
    say

    exit

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

