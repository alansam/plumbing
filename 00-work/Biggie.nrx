#!/usr/bin/env nr
/* NetRexx */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

import java.math.BigInteger

-- remove comments for NetRexx Pipes class imports
-- import org.netrexx.njpipes.pipes.
-- import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class Biggie public

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)

  properties private unused
    memvar_ = Rexx '' -- maybe ...

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method Biggie() public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg .

    anumber = '80207044'.x2d
    biggie  = BigInteger(String(anumber))
    bnumber = Rexx(biggie.toString)
    notbiggie = biggie.not
    cnumber = Rexx(notbiggie.toString)
    say anumber anumber.d2x
    say bnumber bnumber.d2x
    say cnumber + 1 (cnumber + 0).d2x

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

