/* NetRexx */
options replace java comments format

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class testpipe uses RexxTime

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method testpipe(avar = Rexx)
    say 'elapsed time t1:' time('E')
    F = Rexx 'abase'
    T = Rexx 1
    F[0]=6
    F[1]=222
    F[2]=3333
    F[4]=1111
    F[5]=55
    F[6]=444

    say 'F[0]='F[0]
    loop _i = 1 to F[0]
      say 'F['_i']='F[_i]
    end _i
    say

    say 'elapsed time t2:' time('E')

    pipe (apipe stall 1000 )
      stem F |
      sort |
      prefix literal {avar} |
      console |
      stem T

    say 'elapsed time t3:' time('E')

    say
    say 'T[0]='T[0]
    loop _i = 1 to T[0]
      say 'T['_i']='T[_i]
    end _i
    say

    say 'elapsed time t4:' time('E')

   return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) static
    say 'elapsed time 1:' time('R')
    testpipe(Rexx(args))
    say 'elapsed time 2:' time('E')

    exit

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

