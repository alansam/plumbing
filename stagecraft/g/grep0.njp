
  pipe (grep0 stall 1000 debug 0 )
   o: faninany |
      buffer |
      sort |
      spec 1-* 4 |
      console ?

      -- grep  ?
      literal a1a-1 a2b-1 a3c-1 d4d-1 e5e-1 f6f-1 g7g-1|
  f1: fanout |
      spec /1........./ 1 1-* nw |
      o: ?

      literal :a3c-1 |
      spec /1+++++++++/ 1 1-* nw |
      o: ?

      f1: |
      split |
      grep /c-1$/ |
      spec /1~~~~~~~~~/ 1 1-* nw |
      o: ?

    -- numbersregex  ?
      literal a1a-2 a2b-2 a3c-2 d4d-2 e5e-2 f6f-2 g7g-2|
  f2: fanout |
      spec /.2......../ 1 1-* nw |
      o: ?

      literal          3:a3c |
      spec /+2++++++++/ 1 1-* nw |
      o: ?

      f2: |
      split |
      grep (numbers) /c-2$/ |
      spec /~2~~~~~~~~/ 1 1-* nw |
      o: ?

      -- numbers (secondary)  ?
      literal a1a-3 a2b-3 a3c-3 d4d-3 e5e-3 f6f-3 g7g-3|
  f3: fanout |
      spec /..3......./ 1 1-* nw |
      o: ?

      literal          1:a1a;         2:a2b;         4:d4d;         5:e5e;         6:f6f;         7:g7g |
      split ; |
      spec /++3+++++++/ 1 1-* nw |
      o: ?

      f3: |
      split |
  t3: grep (numbers) /c-3$/ |
      hole ?

      t3: |
      spec /~~3~~~~~~~/ 1 1-* nw |
      o: ?

      -- after number  ?
      literal a1a-4 a2b-4 a3c-4 d4d-4 e5e-4 f6f-4 g7g-4|
  f4: fanout |
      spec /...4....../ 1 1-* nw |
      o: ?

      strliteral /~~;:a3c;~d4d;~e5e/ |
      change /~/-/ |
      split ; |
      spec /+++4++++++/ 1 1-* nw |
      o: ?

      f4: |
      split |
      grep (after 2) /c-4$/ |
      spec /~~~4~~~~~~/ 1 1-* nw |
      o: ?

      -- after number (reset) ?
      literal a1a-5 a2b-5 a3c-5 d4c-5 e5e-5 f6f-5 g7g-5|
  f5: fanout |
      spec /....5...../ 1 1-* nw |
      o: ?

      strliteral /~~;:a3c;:d4c;~e5e;~f6f/ |
      change /~/-/ |
      split ; |
      spec /++++5+++++/ 1 1-* nw |
      o: ?

      f5: |
      split |
      grep (after 2) /c-5$/ |
      spec /~~~~5~~~~~/ 1 1-* nw |
      o: ?

      -- separator ?
      literal a1a-6 a2b-6 a3c-6 d4d-6 e5e-6 f6f-6 g7c-6|
  f6: fanout |
      spec /.....6..../ 1 1-* nw |
      o: ?

      strliteral /~~;:a3c;~d4d;~e5e;~~;:g7c/ |
      change /~/-/ |
      split ; |
      spec /+++++6++++/ 1 1-* nw |
      o: ?

      f6: |
      split |
      grep (after 2 separator) /c-6$/ |
      spec /~~~~~6~~~~/ 1 1-* nw |
      o: ?

      -- separator dstring?
      literal a1a-7 a2b-7 a3c-7 d4d-7 e5e-7 f6f-7 g7c-7|
  f7: fanout |
      spec /......7.../ 1 1-* nw |
      o: ?

      literal % %;:a3c;-d4d;-e5e;% %;:g7c |
      split ; |
      spec /++++++7+++/ 1 1-* nw |
      o: ?

      f7: |
      split |
      grep (after 2 separator /% %/) /c-7$/ |
      spec /~~~~~~7~~~/ 1 1-* nw |
      o: ?

      -- noseparator ?
      literal a1a-8 a2b-8 a3c-8 d4d-8 e5e-8 f6f-8 g7c-8|
  f8: fanout |
      spec /.......8../ 1 1-* nw |
      o: ?

      literal :a3c;-d4d;-e5e;:g7c |
      split ; |
      spec /+++++++8++/ 1 1-* nw |
      o: ?

      f8: |
      split |
      grep (noseparator after 2 separator /% %/) /c-8$/ |
      spec /~~~~~~~8~~/ 1 1-* nw |
      o: ?

      -- number before (tertiary) ?
      literal a1a-9 a2b-9 a3c-9 d4d-9 e5e-9 f6f-9 g7c-9|
  f9: fanout |
      spec /........9./ 1 1-* nw |
      o: ?

      strliteral /~~;~a1a;~a2b;:a3c;~~;~e5e;~f6f;:g7c/ |
      change /~/-/ |
      split ; |
      spec /++++++++9+/ 1 1-* nw |
      o: ?

      f9: |
      split |
  r9: grep (n b ter ) /c-9$/ |
      hole ?

      r9: |
      hole ?

      r9: |
      spec /~~~~~~~~9~/ 1 1-* nw |
      o: ?

      -- grep  count ?
      literal a1a-a a2b-a a3c-a d4d-a e5e-a f6f-a g7g-a|
  fa: fanout |
      spec /.........a/ 1 1-* nw |
      o: ?

      literal 3 |
      spec /+++++++++a/ 1 1-* nw |
      o: ?

      fa: |
      split |
      grep ( count ) /^a/ |
      spec /~~~~~~~~~a/ 1 1-* nw |
      o: ?
      -- end of pipe
