
  pipe (juxtax stall 1000 debug 0 )
         < resource_file.a1 |
         strip |
         xlate |
   user: abbrev USER 1 |
         spec word 2 1.10 |
   j:    juxtapose |
         spec 1-* 4 |
         console ?

         user: |
         abbrev LINK 1 |
         spec word 2 1.8 word 3 nextword |
         j: ?
         -- fin


