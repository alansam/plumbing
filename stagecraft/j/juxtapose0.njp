
  pipe (juxtapose0 stall 1000 debug 0 )
   o: faninany |
      spec 1-* 4 |
      console ?

      command ls ./data/shag/ |
--    find to |
      nlocate /-HI_/ |
      spec ,./data/shag/, 1 1-* n |
   f: fanout |
      pad 36 |
   j: juxtapose count |
   i: faninany |
      -- ... |
      o: ?

      f: |
      getfiles |
      locate anycase /death/ |
      j: |
      insert ,*no match*, after |
      i: ?
      -- finis

