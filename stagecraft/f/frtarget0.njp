
  pipe (frtarget0 stall 1000 debug 0 )
   o: faninany |
      spec 1-* 4 |
      console ?

      -- frtarget locate dstring ?
      literal 123-1 234-1 345-1 456-1 567-1 678-1 |
  f1: fanout |
      spec /1~~/ 1 1-* nw |
      o: ?

      f1: |
      split |
      frtarget locate /456-1/ |
      spec /1../ 1 1-* nw |
      o: ?

      -- not frtarget locate dstring ?
      literal 123-2 234-2 345-2 456-2 567-2 678-2 |
  f2: fanout |
      spec /~2~/ 1 1-* nw |
      o: ?

      f2: |
      split |
      not fromtarget locate /456-2/ |
      spec /.2./ 1 1-* nw |
      o: ?
      -- end of pipe

