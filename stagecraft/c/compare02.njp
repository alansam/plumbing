#!/usr/bin/env nr
/* NetRexx Pipes */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

import org.netrexx.njpipes.pipes.
import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class compare02 extends stage public final

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)

    _dlm = '~'.copies(60)

    gullymet = [ '\U00AB\U00A0', '\U00A0\U00BB' ] -- guillemetes + NBRS

  properties private unused
    memvar_ = Rexx '' -- maybe ...

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method compare02() public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
--method run() public

--  rc = 0

--  exit(rc * (rc <> 12))

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method pcomp_01(primary = Rexx, secondary = Rexx, expected = Rexx) private static

    say _dlm
    say 'Primary:  ' gullymet[0] || primary   || gullymet[1]
    say 'Secondary:' gullymet[0] || secondary || gullymet[1]
    say 'Expected: ' gullymet[0] || expected  || gullymet[1]
    say

    do label _plumbing
      pipe (p1 stall 1000 debug 0 )
       o: faninany |
          spec 1-* 4 |
          cons ?

          literal {primary} |
          split ; |
      c1: compare |
     c1a: compare echo, 
                  any      ~2# 1 compare \n\n~,
                  equal    ~MATCH!~,
                  notequal ~GRONK! at rec \\c col \\b.\n~,
                  less     ~  Less:\n      Actual: \\p\n    Expected: \\s\n~,
                  more     ~  More:\n      Actual: \\p\n    Expected: \\s\n~ |
          o: ?

          literal {secondary} |
          split ; |
          c1: ?

          literal {expected} |
          c1a: ?
        -- end of pipe

    end _plumbing
    say

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg .

    pcomp_01('1,2,3,4', '1,2,3,4', 0)
    pcomp_01('1,5,3,4', '1,2,3,4', 0)
    pcomp_01('1,2,3,4', '1,5,3,4', 0)

    pcomp_01('1,2,3,4', '1,2,3,4', 1)
    pcomp_01('1,2,3,4', '1,5,3',   1)
    pcomp_01('1,2,3',   '1,5,3,5', 1)

    pcomp_01('1,2,3,4', '1,2,3,4', -1)
    pcomp_01('1,2,3,4', '1,5,3',   -1)
    pcomp_01('1,2,3',   '1,5,3,5', -1)

    exit

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

