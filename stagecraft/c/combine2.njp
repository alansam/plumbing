
  pipe (combine_tests01)

   o: faninany |
      sort singleok |
      specs 2-* 4 |
      cons ?

  -- combine 1 last  ?
      literal a1a a2b a3c d4d e5e f6f g7c h1h |
      split |
      combine 1 last |
      insert / 000: / before |
      o: ?
      strliteral /a2b d4d f6f h1h/ |
      split |
      insert / 001: / before |
      o: ?

