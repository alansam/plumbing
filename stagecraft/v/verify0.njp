
  pipe (verify0 stall 1000 debug 0 )
   o: faninany |
      buffer |
      sort 1-2 singleok |
      spec 1-* 4 |
      console ?

      literal 12334 69022 10206 0442B AAA1A 09099 |
      split |
      verify 3.1 /0123456789/ |
      spec /1:/ 1 1-* nw |
      o: ?

      literal ABCCD FI@BB A@B@F @DDB2 111A1 @I@II |
      split |
      verify 5.1 /0123456789/ |
      spec /2:/ 1 1-* nw |
      o: ?

      literal a1a a2b a3c d4d e5e f6f g7c|
      split |
      verify /ab12/ |
      spec /3:/ 1 1-* nw |
      o: ?

      literal a1a A2b a3c d4d e5e f6f g7c|
      split |
      verify 3.1 /abe/ |
      spec /4:/ 1 1-* nw |
      o: ?

      literal a1a a2B a3c d4d e5e f6f g7c|
      split |
      verify anycase /ab12/ |
      spec /5:/ 1 1-* nw |
      o: ?

      literal a1a A2B a3c d4d e5e f6f g7c|
      split |
      verify anycase 3.1 /abe/ |
      spec /6:/ 1 1-* nw |
      o: ?

      literal a1a a2b a3c d4d e5e f6f g7c|
      split |
      verify /ab12/ a-d A7-aa /xyZ/ |
      spec /7:/ 1 1-* nw |
      o: ?
      -- fin

