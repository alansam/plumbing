import org.netrexx.njpipes.pipes.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class var_stage0 extends stage public final

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  properties public constant
    _dlm = '~'.copies(60)

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method var_stage0 public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(argc = String[]) public static
    π = Math.PI

    mval = 0
    mval[0] = 0

    say _dlm
    do label _plumbing

      pipe (pi end ? stall 1000 debug 0 )
       o: faninany |
          spec 1-* 4 |
          console ?

          var_stage π |
          spec /π :/ 1 1-* nw |
       f: fanout |
          stemw mval ?

          f: |
          o: ?
          -- fin

    end _plumbing
    say

    say _dlm
    say '   mval[]:'
    loop _m = 0 to mval[0]
      say _m.right(6)':' mval[_m]
    end _m
    say

    piperc = var_stage0().rc()
    say 'var_stage0 RC='piperc

    exit (piperc * (piperc <> 12)) -- Not sure why 12 is OK but I see this a lot in examples

