
  pipe (reverse0 stall 1000 debug 0 )
   o: faninany |
      spec 1-* 4 |
      console ?

      literal Hello, World! |
      reverse |
      spec /0/ 1 1-* nw |
      o: ?

      literal record 1 xyz;record 2 abc;record 3 xyz;record 4 def;fin xyz |
      split ; |
      reverse |
      find zyx |
      reverse |
      spec /1/ 1 1-* nw |
      o: ?
      -- fin

