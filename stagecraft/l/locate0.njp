
  pipe (locate0 stall 1000 debug 0 )
   o: faninany |
      buffer |
      sort singleok |
      spec 1-* 4 |
      console ?

      literal abc |
      literal |
      locate |
      spec /1~~~~/ 1 1-* nw |
      o: ?

      literal xaby |
      literal xxyab |
      locate 1.4 /ab/ |
      spec /~2~~~/ 1 1-* nw |
      o: ?

      literal xaby abcd cdab |
      split |
      locate (1-2 3-4) /ab/ |
      spec /~~3~~/ 1 1-* nw |
      o: ?

      < ./data/pipparm_txtlib.a1 |
      locate 1 x02 |
      count lines |
      spec /~~~4~/ 1 1-* nw.4 right |
      o: ?

      < ./data/pipparm_txtlib.a1 |
      count lines |
      spec /~~~~5/ 1 1-* nw.4 right |
      o: ?
      -- fin

