
  pipe (inside0 stall 1000 debug 0 )
   o: faninany |
      sort singleok |
      spec 1-6 4 10-* nw | -- remove N- prefix |
      console ?

      -- select third - sixth ?
      literal 1-first one,2-second one,3-third one,4-fourth one,5-fifth one,6-sixth one,7-seventh one,8-eighth one  |
      split , |
      notinside /2-second/ /7-seventh/ |
      spec /0~~~~~/ 1 1-* nw |
      o: ?

      -- select third - sixth -- case insensitive ?
      literal 1-first one,2-second one,3-third one,4-fourth one,5-fifth one,6-sixth one,7-seventh one,8-eighth one  |
      split , |
      notinside anycase /2-SECOND/ /7-SEVENTH/ |
      spec /~1~~~~/ 1 1-* nw |
      o: ?

      -- select second - fifth -- case insensitive ?
      literal 1-first one,2-second one,3-third one,4-fourth one,5-fifth one,6-sixth one,7-seventh one,8-eighth one  |
      split , |
      notinside anycase /2-sEConD/ 3 |
      spec /~~2~~~/ 1 1-* nw |
      o: ?

      -- select first,second & sixth,seventh (5th record duplicates 1st) ?
      literal 1-first one,2-second one,3-third one,4-fourth one,1-first one,6-sixth one,7-seventh one,8-eighth one  |
      split , |
      notinside /1-first/ 2 |
      spec /~~~3~~/ 1 1-* nw |
      o: ?

      -- empty selection, picks all ?
      literal 1-first one,2-second one,3-third one,4-fourth one,5-fifth one,6-sixth one,7-seventh one,8-eighth one  |
      split , |
      notinside // 2 |
      spec /~~~~4~/ 1 1-* nw |
      o: ?

      -- case sensitive selection will fail ?
      literal 1-first one,2-second one,3-third one,4-fourth one,5-fifth one,6-sixth one,7-seventh one,8-eighth one  |
      split , |
      notinside /2-sEConD/ 3 |
      spec /~~~~~5/ 1 1-* nw |
      o: ?
      -- end of pipe

