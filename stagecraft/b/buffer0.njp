#!/usr/bin/env nr
/* NetRexx Pipes */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

import org.netrexx.njpipes.pipes.
import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class buffer0 extends stage public final

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)

  properties private unused
    memvar_ = Rexx '' -- maybe ...

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method buffer0() public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method run() public

    rc = 0

    exit(rc * (rc <> 12))

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg .

    cbuff    = ''
    cbuff[0] = 0

    do label _plumbing

      pipe (b0 stall 1000 debug 0 )
          console eof ~.*~ pr ~whut (to terminate input use .*):~ |
          buffer |
          stem cbuff

    end _plumbing

    say '--' 0.right(3)':' cbuff[0]
    loop _r = 1 to cbuff[0]
      say '--' _r.right(3)':' cbuff[_r]
    end _r
    say

    exit

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

