#!/usr/bin/env nr
/* NetRexx Pipes */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

import org.netrexx.njpipes.pipes.
import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class dict0 extends stage public final

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)
    _keys  = 'A B C D E F'

  properties private unused
    memvar_ = Rexx '' -- maybe ...

  properties private 
    hash00_ = Hashtable()
    hash01_ = Hashtable()

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method dict0() public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method run() public

    rc = 0

    -- pipe read loop
    loop label _loopy forever
      line = Rexx peekto()
      parse line key val .
      val = val + 17
      line = key val
      output(line)
      readto()
    catch StageError
      rc = rc()
    end _loopy

    exit(rc * (rc <> 12))

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method getHash00() public returns Hashtable

    return hash00_

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method getHash01() public returns Hashtable

    return hash01_

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method init() private

    parse _keys A B C D E F .

    data    = ''
    data[A] = 125
    data[B] = 444
    data[C] = 17
    data[D] = 1
    data[E] = 4472
    data[F] = 1966

    loop _k = 1 to _keys.words()
      key = _keys.word(_k)
      getHash00().put(key, data[key])
    end _k

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method reports() private

    say 'Input:'
    loop _k = 1 to _keys.words()
      key = _keys.word(_k)
      say key.right(5) || ':' (Rexx getHash00().get(key))
    end _k
    say

    say 'Output:'
    loop _k = 1 to _keys.words()
      key = _keys.word(_k)
      say key.right(5) || ':' (Rexx getHash01().get(key))
    end _k
    say

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg .

    thiz = dict0()
    thiz.init()

    do label _plumbing

      pipe (dt stall 1000 debug 0 -gen )
          dict {thiz.getHash00()} | |
          join 1 / / |
          dict0 |
          sort |
          split |
          hashw {thiz.getHash01()} |
          console

    end _plumbing

    say
    thiz.reports()

    exit

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

