
  pipe (deal02 stall 1000 debug 0 )
   o: faninany |
      spec 1-* 4 |
      console ?

      literal zero;one;two;three;four;five;six;seven;eight;nine;,
              ten;eleven;twelve;thirteen;fourteen;,
              fifteen;sixteen;seventeen;eighteen;nineteen;,
              twenty |
      split ; |
      strip both blank |
  d1: deal secondary |
      spec /    >/ 1 1-* nw |
      o: ?

      literal 0;0;1;1;2;2;3;3;4;4;0;0;1;1;2;2;3;3;4;4;0;0;1;1;2;2;3;3;4;4|
      split ; |
      d1: |
      spec /   >>/ 1 1-* nw |
      o: ?

      d1: |
      spec /  >>>/ 1 1-* nw |
      o: ?

      d1: |
      spec / >>>>/ 1 1-* nw |
      o: ?

