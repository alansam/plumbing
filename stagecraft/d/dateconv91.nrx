/* NetRexx Pipes */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

-- import org.netrexx.njpipes.pipes.
-- import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class dateconv91 public

  properties constant
    _true  = (1 == 1)
    _false = \(_true)

    mnames = 'Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec'
    _14ths = '014 045 073 104 134 165 195 226 257 287 318 348'
    dlm = '~'.copies(60)

    pipefile = './data/dateconv91_pipes.njp'

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method dateconv91() public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg .

    lineout(pipefile, '-- dateconv sample pipelines ?', 1)
    lineout(pipefile, ' ')

    loop _m = 1 to 12
      MM_ = _m.right(2, 0)
      ndate = '14 '   || mnames.word(_m) || ' 2026 12:00:00.012345' -- normal
      udate =            MM_             || '/14/2026 12:00:00.012345' -- usa
      idate = '2026-' || MM_             || '-14 12:00:00.012345' -- iso
      ddate = '2026-' || MM_             || '-14-12.00.00.012345' -- db2
      cdate = '2026/' || MM_             || '/14 12.00.00.012345' -- csl
      pdate = '2026'  || MM_             || '14120000012345' -- pipe
      edate = '14.'   || MM_             || '.2026 12:00:00.012345' -- csl
      jdate = '2026.' || _14ths.word(_m) || ' 12:00:00.012345' -- julian
      datties = ''
      datties[0] = 0
      _d = 0
      _d = _d + 1; datties[_d] = 'normal' ndate
      _d = _d + 1; datties[_d] = 'usa'    udate
      _d = _d + 1; datties[_d] = 'iso'    idate
      _d = _d + 1; datties[_d] = 'db2'    ddate
      _d = _d + 1; datties[_d] = 'csl'    cdate
      _d = _d + 1; datties[_d] = 'pipe'   pdate
      _d = _d + 1; datties[_d] = 'eur'    edate
      _d = _d + 1; datties[_d] = 'julian' jdate
      datties[0] = _d

      odate = [ 'normal', 'usa', 'usa_short', 'iso', 'iso_short', 'julian' ]

      loop _id = 1 to datties[0]
        parse datties[_id] indate dlit
        loop _od = 0 to odate.length - 1
          outdate = odate[_od]
          if indate == outdate then
            iterate _od
          pipename = indate.left(1) || outdate.left(1) || MM_
          say dlm.overlay(' MM:' MM_', Date' indate 'to' outdate' ', 3)
          do label _plumbing
            say 'dateconvert 'indate' 'outdate

            pcmd = -
              'pipe (D'pipename 'stall 1000 debug 0 )' -
               'o: fanin 0 1 2 |' -
                  'spec 1-* 4 |' -
                  'console ?' -
                  '' -
                  'literal 'dlit' |' -
                  'spec / In:/ 1 1-* nw |' -
                  'o: ?' -
                  '' -
                  'literal 'dlit' |' -
                  'dateconvert 'indate' 'outdate' timeout |' -
                  'spec /Out:/ 1 1-* nw |' -
                  'o: ?' -
                  '-- the end'
            say pcmd
            say

            lineout(pipefile, pcmd) -- echo pipe command to a file
            lineout(pipefile, ' ')

            address pipe pcmd

          end _plumbing
          say
        end _od
        say
      end _id
      say
    end _m
    say

    lineout(pipefile, ' ')
    lineout(pipefile, '-- end of dateconv samples ?')
    lineout(pipefile, ' ')

    say '-- end of job'
    say

    exit

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

