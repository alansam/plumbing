
  pipe (diskslow0 stall 1000 debug 0 )
   o: faninany |
      spec 1-* 4 |
      console ?

      diskslow ./data/_ruler |
   f: fanout |
      spec /[   >/ 1 1-* next /<   ]/ next |
      o: ?

      f: |
      spec /[copy>/ 1 1-* next /<copy]/ next |
   k: fanout |
      diskslow ./tmp/diskslow0_out.a3 ?

      k: |
      change 1-* /copy/dup/ |
      o: ?

  -- disk/file handling stages:
  --   < diskr filer, > diskw filew, >> diska filea, diskslow

