#!/usr/bin/env nr
/* NetRexx Pipes */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

import org.netrexx.njpipes.pipes.
import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class stem0 extends stage public final

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)
    _dlm   = '~'.copies(60)

  properties private unused
    memvar_ = Rexx '' -- maybe ...

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method stem0() public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
--method run() public

--  rc = 0

--  exit(rc * (rc <> 12))

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg .

    wicked = Rexx 'wicked'
    _w = Rexx 0
    _w = _w + 1; wicked[_w] = 'Something'
    _w = _w + 1; wicked[_w] = 'wicked'
    _w = _w + 1; wicked[_w] = 'this'
    _w = _w + 1; wicked[_w] = 'way'
    _w = _w + 1; wicked[_w] = 'comes'
    wicked[0] = _w

    pranging = _true
    prang = Rexx 1

    say _dlm
    weird(wicked)
    say

    say _dlm
    do label _plumbing

      pipe (szw stall 1000 debug 0 )
       o: faninany |
          buffer |
          sort 1-3 singleok |
          specs 1-* 4 |
          console ?

          stem wicked |
       r: fanout |
          spec /szr:/ 1 1-* nw |
          o: ?

          r: |
          literal Quoth Weird Sisters: |
       w: fanout |
          stem prang ?

          w: |
          spec /szw:/ 1 1-* nw |
          o: ?
          -- fin

      say

    catch ex = Throwable /* perhaps */
      pranging = _false
      say "GRONK!" ex.toString()
    end _plumbing

    if pranging then do
      say _dlm
      weird(prang)
      say
    end

    exit

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method weird(wik = Rexx) private static

    scottish = ''
    loop _w = 1 to wik[0]
      scottish = scottish || wik[_w] || ' '
    end _w
    scottish = scottish.strip()
    say  '   ' || scottish

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

