
  pipe (strfind0 stall 1000 debug 0 )
   o: faninany |
      buffer |
      sort 1-5 singleok |
      spec 1-* 4 |
      console ?

      literal axc;abc;xyz |
      split ; |
  f1: fanout |
  j1: juxtapose |
      spec ,1: /a c/, 1 1-* nw |
      o: ?

      f1: |
      spec ,1: ....., 1 1-* nw |
      o: ?

      f1: |
  d1: strnfind /a c/ |
      spec / =/ 1 1-* nw |
      j1: ?

      d1: |
      spec ,1:_  ^= , 1 1-* nw |
      o: ?

      literal dxc;dbc;xyz |
      split ; |
  f2: fanout |
  j2: juxtapose |
      spec ,2: /d c/, 1 1-* nw |
      o: ?

      f2: |
      spec ,2: ....., 1 1-* nw |
      o: ?

      f2: |
  d2: strnfind /d c/ |
      spec / =/ 1 1-* nw |
      j2: ?

      d2: |
      spec ,2:_  ^= , 1 1-* nw |
      o: ?

      literal f c;fxc;f_c;xyz |
      split ; |
  f3: fanout |
  j3: juxtapose |
      spec ,3: /f c/, 1 1-* nw |
      o: ?

      f3: |
      spec ,3: ....., 1 1-* nw |
      o: ?

      f3: |
  d3: strnfind /f c/ |
      spec / =/ 1 1-* nw |
      j3: ?

      d3: |
      spec ,3:_  ^= , 1 1-* nw |
      o: ?

      literal h c;hxc;t_c;xyz |
      split ; |
  f4: fanout |
  j4: juxtapose |
      spec ,4: /h_c/, 1 1-* nw |
      o: ?

      f4: |
      spec ,4: ....., 1 1-* nw |
      o: ?

      f4: |
  d4: strnfind /h_c/ |
      spec / =/ 1 1-* nw |
      j4: ?

      d4: |
      spec ,4:_  ^= , 1 1-* nw |
      o: ?

      literal abc axc axy xyc |
      split |
  f5: fanout |
  j5: juxtapose |
      spec ,5: /a c/, 1 1-* nw |
      o: ?

      f5: |
      spec ,5: ....., 1 1-* nw |
      o: ?

      f5: |
  d5: strnfind /a c/ |
      spec / =/ 1 1-* nw |
      j5: ?

      d5: |
      spec ,5:_  ^= , 1 1-* nw |
      o: ?
      -- end of pope

