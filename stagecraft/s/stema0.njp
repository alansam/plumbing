#!/usr/bin/env nr
/* NetRexx Pipes */
-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
options format java comments replace symbols decimal

import org.netrexx.njpipes.pipes.
import org.netrexx.njpipes.stages.

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
class stema0 extends stage public final

  properties public constant
    _true  = (1 == 1)
    _false = \(_true)
    _dlm   = '~'.copies(60)

  properties private unused
    memvar_ = Rexx '' -- maybe ...

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
-- Default constructor
  method stema0() public

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
--method run() public

--  rc = 0

--  exit(rc * (rc <> 12))

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method main(args = String[]) public static

    arg = Rexx(args)
    parse arg .

    wicked = Rexx 'wicked'
    _w = Rexx 0
    _w = _w + 1; wicked[_w] = 'Something'
    _w = _w + 1; wicked[_w] = 'wicked'
    _w = _w + 1; wicked[_w] = 'this'
    _w = _w + 1; wicked[_w] = 'way'
    _w = _w + 1; wicked[_w] = 'comes'
    wicked[0] = _w

    drum = Rexx 'drum'
    _d = Rexx 0
    _d = _d + 1; drum[_d] = 'Quoth Weird Sisters:'
    _d = _d + 1; drum[_d] = ' '
    _d = _d + 1; drum[_d] = 'A'
    _d = _d + 1; drum[_d] = 'drum'
    _d = _d + 1; drum[_d] = 'a'
    _d = _d + 1; drum[_d] = 'drum'
    _d = _d + 1; drum[_d] = 'Macbeth'
    _d = _d + 1; drum[_d] = 'doth'
    _d = _d + 1; drum[_d] = 'come'
    _d = _d + 1; drum[_d] = ' '
    drum[0] = _d
    
    weirding = _true

    say _dlm
    weird(wicked)
    say

    say _dlm
    weird(drum)
    say

    say _dlm
    do label _plumbing

      pipe (sta stall 1000 debug 0 )
       o: faninany |
          buffer |
          sort 1-3 singleok |
          specs 1-* 4 |
          console ?

          stemr wicked |
       w: fanout |
          spec /stw:/ 1 1-* nw |
          o: ?

          w: |
          stema drum |
          o: ?
          -- fin
      say
      say _dlm

      pipe (str stall 1000 debug 0 )
       o: faninany |
          buffer |
          sort 1-3 singleok |
          specs 1-* 4 |
          console ?

          stemr drum |
          spec /sta:/ 1 1-* nw |
          o: ?
          -- fin

      say

    catch ex = Throwable /* perhaps */
      weirding = _false
      say "GRONK!" ex.toString()
    end _plumbing

    if weirding then do
      say _dlm
      weird(drum)
      say
    end

    exit

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8
  method weird(wik = Rexx) private static

    scottish = ''
    loop _w = 1 to wik[0]
      scottish = scottish || wik[_w] || ' '
    end _w
    scottish = scottish.strip()
    say  '   ' || scottish

    return

-- . ... 1 ... ... 2 ... ... 3 ... ... 4 ... ... 5 ... ... 6 ... ... 7 ... ... 8

